# ---------------------------------------------------------------------------
# MedScribe Live - environment configuration
# Copy this file to .env and fill in your values.
# ---------------------------------------------------------------------------

# --- AI provider -----------------------------------------------------------
# local = Ollama, on this machine or on a GPU host reached through a tunnel.
AI_MODE=local
# Point at the Ollama host, e.g. the trycloudflare URL from a Kaggle notebook (no /v1).
LOCAL_LLM_BASE_URL=http://localhost:11434
# Pick the tier for the hardware the model runs on:
#   gemma4:e2b  low-end: CPU-only PC with 8-16 GB RAM, or a 4-6 GB GPU
#   gemma4:e4b  default: 8 GB+ GPU (Kaggle T4, RTX 3060/4060) or 16 GB+ RAM
#   gemma4:12b  quality: 16 GB+ GPU; slower, closest to the online version
LOCAL_LLM_MODEL=gemma4:e4b
LOCAL_LLM_TIMEOUT_SECONDS=180
LOCAL_LLM_MAX_RETRIES=2
LOCAL_LLM_TEMPERATURE=0.1
LOCAL_LLM_NUM_CTX=4096
LOCAL_LLM_MAX_TOKENS=1200
# Tried in order if LOCAL_LLM_MODEL is not installed or returns unusable JSON.
LOCAL_LLM_FALLBACK_MODELS=gemma4:e2b
# Gemma 4 reasoning trace before the note: adds latency, keep off.
LOCAL_LLM_THINK=false
# ollama = native /api/chat (honours num_ctx, keep_alive, streaming). Keep this
# when LOCAL_LLM_BASE_URL is a tunnel to a remote Ollama (e.g. a Kaggle notebook).
# openai = llama.cpp / vLLM OpenAI-compatible servers.
LOCAL_LLM_API=ollama
# Optional bearer token if the tunnel is protected.
LOCAL_LLM_API_KEY=
LOCAL_LLM_CONNECT_TIMEOUT_SECONDS=15
LOCAL_LLM_KEEP_ALIVE=30m
LOCAL_LLM_STREAM=true
# Loads the model on the LLM host at backend start-up. Off by default.
LOCAL_LLM_WARMUP_ON_STARTUP=false
# Skip the LLM for this long after a failure during a consultation; the final pass always retries.
LLM_RETRY_COOLDOWN_SECONDS=20

# Optional cloud Gemini fallback
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Set to false if connecting through corporate/campus firewalls with custom SSL inspection
GEMINI_VERIFY_SSL=true
# Optional HTTP/HTTPS proxy URL (e.g., http://proxy.company.local:8080)
GEMINI_HTTP_PROXY=

# Gemini incremental processing (avoid one API call per word)
GEMINI_UPDATE_INTERVAL_SECONDS=10
GEMINI_MIN_SEGMENTS_PER_UPDATE=3
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_RETRIES=3

# --- Database --------------------------------------------------------------
# PostgreSQL is the production/docker target.
DATABASE_URL=postgresql+asyncpg://medscribe:medscribe@localhost:5432/medscribe
# If PostgreSQL is unreachable at startup and this is true, MedScribe falls back
# to a local SQLite file so the prototype still runs. Never enable in production.
ALLOW_SQLITE_FALLBACK=true
SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./medscribe_dev.db

# --- Application -----------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# --- Demo Mode -------------------------------------------------------------
ENABLE_DEMO_MODE=true
# Seconds between scripted utterances in Demo Mode.
DEMO_SEGMENT_INTERVAL_SECONDS=2.5

# --- Pipeline providers ----------------------------------------------------
# Speech-to-text for REAL audio. Audio is NOT sent to the cloud.
#   faster_whisper   - CTranslate2 Whisper on this PC (recommended for RTX 4050)
#   tanglish_whisper - Badri0510 DPO model for mixed Tamil script + English Latin terms
#   tanglish_med     - surendirakrishna 1.7B clinical model for Tanglish doctor-patient dialogues
#   gemini           - (optional) send the WAV to Gemini; uses quota
ASR_PROVIDER=faster_whisper
FASTER_WHISPER_MODEL=large-v3-turbo
TANGLISH_WHISPER_MODEL=Badri0510/whisper-tanglish-DPO-production
TANGLISH_MED_MODEL=surendirakrishna/OHM-Tanglish-MedASR-1.7B-v152
# auto = cuda / float16 when a GPU is present, otherwise cpu / int8.
ASR_DEVICE=auto
ASR_COMPUTE_TYPE=auto
ASR_BEAM_SIZE=2
# Parallel decodes per loaded Whisper model (one per concurrent consultation room).
ASR_NUM_WORKERS=2
# Loads Whisper at backend start-up instead of on the first consultation. Off by default.
ASR_WARMUP_ON_STARTUP=false
INDIC_WHISPER_USE_TRANSFORMERS=false
# auto = detect the language of every utterance (code-switching); ta/en/hi forces one.
INDIC_ASR_LANGUAGE=code_switching
# Languages spoken in the clinic. Detection is restricted to these so Tamil is not
# mistaken for Malayalam or Hindi for Urdu.
ASR_LANGUAGES=ta,hi,en
# Code-mixed example prompts that keep English words in English (Tanglish / Hinglish).
ASR_STYLE_PROMPTS=true
# Leave blank. Listing drug names here makes Whisper invent those drugs in the transcript.
INDIC_ASR_PROMPT_BIASING=
# Second recogniser: indic_conformer sends Hindi/Tamil/Telugu-heavy utterances to
# AI4Bharat IndicConformer-600M and re-recognises Whisper output that loops or comes
# out in the wrong script. Strongly recommended for Tamil: Whisper alone is poor at it.
# Needs: pip install transformers torchaudio onnxruntime-gpu, plus HUGGINGFACE_TOKEN
# from an account that accepted the model's terms on huggingface.co. If it cannot
# load, Whisper handles everything. none = Whisper only.
ASR_SECOND_PASS=indic_conformer
ASR_SECOND_PASS_MODEL=ai4bharat/indicconformer_stt_multi_hybrid_rnnt_600m
# ctc (fastest, never invents words) | rnnt (slightly more accurate, slower)
ASR_SECOND_PASS_DECODER=ctc
# local (pitch clustering, 2 speakers) | pyannote | gemini | mock
DIARIZATION_PROVIDER=local
# Blank = use GEMINI_MODEL. Set to transcribe with a cheaper/faster model.
GEMINI_ASR_MODEL=
GEMINI_ASR_TIMEOUT_SECONDS=180
GEMINI_ASR_MAX_RETRIES=2
PYANNOTE_MODEL=pyannote/speaker-diarization-3.1
HUGGINGFACE_TOKEN=

# --- Audio -----------------------------------------------------------------
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_STORAGE_DIR=./storage/audio

# --- Security (development user system) ------------------------------------
DEV_AUTH_ENABLED=true
DEV_USER_EMAIL=dev.clinician@medscribe.local
DEV_USER_ROLE=DOCTOR
SECRET_KEY=change-me-in-production
DATA_RETENTION_DAYS=30

# --- Monitoring ------------------------------------------------------------
ENABLE_METRICS=true
